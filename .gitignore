!.env.example
node_modules/
test-results/
playwright-report/

# 외부 클론 (read-only, 자체 git 관리)
external/

# Cache
.cache/
.jaramlaw-brain/
*.log

# pytest-cov 산출물 (머신별, 커밋 대상 아님)
.coverage
